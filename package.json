{
  "name": "dpiyf-lettertown",
  "version": "2.0.0",
  "description": "DPIYF Lettertown: a daily word puzzle on a hex board. Trace words through neighbouring tiles, always through the gold key tile.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "build:dict": "node scripts/build-dictionary.mjs",
    "sample": "vite-node scripts/sample.ts",
    "deploy:firebase": "npm run build && npx firebase-tools deploy --only hosting",
    "build:app": "tsc -b && BASE_PATH=/ VITE_API_BASE=https://word-game-leaderboard.danlagstein.workers.dev VITE_NATIVE=1 vite build && cap sync ios"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.1"
  }
}
